{
  "collections": {
    "users": {
      "rules": {
        "read": "request.auth != null",
        "write": "request.auth != null && (request.auth.uid == resource.id || request.auth.token.email in ['ubittechnologiez@gmail.com', 'md@ubittechnologiez.com', 'admin@ubittechnologiez.com'])"
      },
      "fields": {
        "email": { "type": "string", "required": true },
        "name": { "type": "string", "required": false },
        "photoURL": { "type": "string", "required": false },
        "role": { "type": "string", "required": false },
        "createdAt": { "type": "timestamp", "required": false }
      }
    },
    "gallery": {
      "rules": {
        "read": "true",
        "write": "request.auth != null && request.auth.token.email in ['ubittechnologiez@gmail.com', 'md@ubittechnologiez.com', 'admin@ubittechnologiez.com']"
      },
      "fields": {
        "url": { "type": "string", "required": true },
        "title": { "type": "string", "required": false },
        "description": { "type": "string", "required": false },
        "category": { "type": "string", "required": false },
        "client": { "type": "string", "required": false },
        "altText": { "type": "string", "required": false },
        "featured": { "type": "boolean", "required": false },
        "position": { "type": "number", "required": true },
        "createdAt": { "type": "timestamp", "required": false }
      }
    },
    "quotes": {
      "rules": {
        "read": "request.auth != null && request.auth.token.email in ['ubittechnologiez@gmail.com', 'md@ubittechnologiez.com', 'admin@ubittechnologiez.com']",
        "create": "true",
        "update": "request.auth != null && request.auth.token.email in ['ubittechnologiez@gmail.com', 'md@ubittechnologiez.com', 'admin@ubittechnologiez.com']",
        "delete": "request.auth != null && request.auth.token.email in ['ubittechnologiez@gmail.com', 'md@ubittechnologiez.com', 'admin@ubittechnologiez.com']"
      },
      "fields": {
        "companyName": { "type": "string", "required": true },
        "contactName": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "phone": { "type": "string", "required": false },
        "serviceType": { "type": "string", "required": true },
        "estimatedBudget": { "type": "string", "required": false },
        "projectDescription": { "type": "string", "required": true },
        "status": { "type": "string", "required": false },
        "createdAt": { "type": "timestamp", "required": false }
      }
    },
    "clients": {
      "rules": {
        "read": "true",
        "write": "request.auth != null && request.auth.token.email in ['ubittechnologiez@gmail.com', 'md@ubittechnologiez.com', 'admin@ubittechnologiez.com']"
      },
      "fields": {
        "name": { "type": "string", "required": true },
        "logoUrl": { "type": "string", "required": true },
        "position": { "type": "number", "required": true },
        "website": { "type": "string", "required": false },
        "isActive": { "type": "boolean", "required": false },
        "createdAt": { "type": "timestamp", "required": false },
        "updatedAt": { "type": "timestamp", "required": false }
      }
    }
  }
}
