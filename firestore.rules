rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'ubittechnologiez@gmail.com' ||
        request.auth.token.email == 'md@ubittechnologiez.com' ||
        request.auth.token.email == 'admin@ubittechnologiez.com' ||
        request.auth.token.email.matches('.*@ubittechnologiez[.]com$')
      );
    }

    // Public showcase read, Admin write
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public quote submission, Admin view and manage
    match /quotes/{quoteId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
